#!/usr/bin/env bash
set -euo pipefail

. common.bash

# Clean up everything that has been generated by docker-compose
rm -f "$CA1_KEY" "$CA2_KEY" "$CA1_CERT" "$CA2_CERT"
rm -f config.yaml env

# Purge the database volume so we have a clean state
docker volume rm rampup_db || true

# Purge the container image built by compose
docker image rm dns3ld-dev:rampup || true
